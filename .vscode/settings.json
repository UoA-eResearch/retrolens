    "**/.venv": true,
    "**/__pycache__": true,
    ".gitattributes": true,
    ".nojekyll": true,
    "DSAS.ipynb": true,
    "DSAS_CoastSat_transects.ipynb": true,
    "EDA.ipynb": true,
    "GCPs.ipynb": true,
    "ICE.ipynb": true,
    "UNCY.ipynb": true,
    "Uncertainty.ipynb": true,
    "check_tiles.ipynb": true,
    "empties.ipynb": true,
    "aggregate_shapefiles_to_geojson.py": true,
    "check_tiffs.py": true,
    "coco.py": true,
    "fetch.py": true,
    "filter_coco.py": true,
    "fix_folders.py": true,
    "fix_shorelines_geojson.py": true,
    "generate_mapserver_conf.py": true,
    "jp2_to_tif.py": true,
    "make_tiles.py": true,
    "mapproxy.py": true,
    "rasterio_test.py": true,
    "*.html": true,
    "mapproxy.yaml": true,
    "mapproxy_base.yaml": true,
    "mapserver.map": true,
    "mount_drive.sh": true,
